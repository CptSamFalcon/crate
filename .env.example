# Discord bot token (TOKEN and DISCORD_TOKEN both work)
TOKEN=
# Default dashboard server. Invite the bot to more servers to switch from the crate.
GUILD_ID=

# Optional. Defaults to the bot application id after login.
CLIENT_ID=

# DroppedNeedle
DROPPEDNEEDLE_URL=https://your-droppedneedle.example
DROPPEDNEEDLE_TOKEN=
DROPPEDNEEDLE_USERNAME=
DROPPEDNEEDLE_PASSWORD=

# Web dashboard (optional). Discord OAuth needs HTTPS except on localhost.
WEB_PUBLIC_URL=https://rou.yourdomain
WEB_PORT=8787
# Leave unset to listen on 127.0.0.1 (the Cloudflare tunnel target).
WEB_BIND=
CLIENT_SECRET=
# Optional but recommended. Defaults to a hash of TOKEN.
SESSION_SECRET=

# Cloudflare Tunnel token from Zero Trust → Networks → Tunnels.
# Public hostname should point at http://127.0.0.1:8787
CLOUDFLARE_TUNNEL_TOKEN=
