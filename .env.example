# Discord bot token (TOKEN and DISCORD_TOKEN both work)
TOKEN=
GUILD_ID=

# Optional. Defaults to the bot application id after login.
CLIENT_ID=

# DroppedNeedle
DROPPEDNEEDLE_URL=https://your-droppedneedle.example
DROPPEDNEEDLE_TOKEN=
DROPPEDNEEDLE_USERNAME=
DROPPEDNEEDLE_PASSWORD=

# Web dashboard (optional). Discord OAuth needs HTTPS except on localhost.
WEB_PUBLIC_URL=https://rou.yourdomain
WEB_PORT=8787
CLIENT_SECRET=
# Optional. Defaults to a hash of TOKEN.
SESSION_SECRET=
