    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "ffmpeg-static": "^5.2.0",
    "hono": "^4.13.8",
    "libsodium-wrappers": "^0.7.15",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "tsx": "^4.20.5",
    "zod": "^3.25.76"
